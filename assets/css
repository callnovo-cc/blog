:root {
  --navy: #141a47;
  --navy-deep: #0c1028;
  --blue: #2098cd;
  --blue-hover: #167eac;
  --blue-soft: #e8f5fb;
  --text: #1c2740;
  --text-muted: #4e5578;
  --text-soft: #6f7899;
  --surface: #ffffff;
  --surface-soft: #f4f6fa;
  --surface-tint: #eef7fb;
  --border: #dce2ec;
  --border-strong: #bac6d8;
  --focus: #2098cd;
  --max-shell: 1180px;
  --max-narrow: 760px;
  --max-article: 760px;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --shadow-sm: 0 1px 2px rgba(12, 16, 40, 0.06);
  --shadow-md: 0 12px 28px rgba(12, 16, 40, 0.09);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--surface-soft);
  color: var(--text);
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 18px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-md);
}

a {
  color: var(--blue-hover);
  text-decoration: none;
}

a:hover {
  color: var(--blue);
}

a:focus-visible,
button:focus-visible,
[tabindex]:focus-visible {
  outline: 3px solid rgba(32, 152, 205, 0.45);
  outline-offset: 3px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.site-shell {
  width: min(calc(100% - 40px), var(--max-shell));
  margin: 0 auto;
}

.site-shell-narrow {
  max-width: var(--max-narrow);
}

.site-shell-article {
  max-width: var(--max-article);
}

.skip-link {
  position: absolute;
  top: 14px;
  left: -9999px;
  z-index: 1000;
  padding: 10px 14px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--navy);
  font-size: 0.9rem;
  font-weight: 700;
}

.skip-link:focus {
  left: 16px;
}

/* Global header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(220, 226, 236, 0.88);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12px);
}

.header-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  min-height: 78px;
}

.site-brand {
  display: inline-flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
  color: var(--navy);
  line-height: 1.1;
}

.site-brand:hover {
  color: var(--navy);
}

.site-brand-name {
  font-size: 1.06rem;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.site-brand-section {
  color: var(--blue-hover);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.site-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px 20px;
  flex-wrap: wrap;
}

.site-nav a {
  position: relative;
  padding: 8px 0;
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 700;
  line-height: 1.2;
}

.site-nav a:hover,
.site-nav a[aria-current="page"] {
  color: var(--navy);
}

.site-nav a[aria-current="page"]::after {
  position: absolute;
  right: 0;
  bottom: 1px;
  left: 0;
  height: 2px;
  border-radius: 999px;
  background: var(--blue);
  content: "";
}

.site-main {
  min-height: calc(100vh - 240px);
}

/* Shared display language */
.eyebrow,
.cta-eyebrow,
.featured-label {
  margin: 0 0 12px;
  color: var(--blue-hover);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 12px 18px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 0.92rem;
  font-weight: 800;
  line-height: 1.2;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button-primary {
  background: var(--blue);
  box-shadow: var(--shadow-sm);
  color: #fff;
}

.button-primary:hover {
  background: var(--blue-hover);
  color: #fff;
}

.button-secondary {
  border-color: var(--border-strong);
  background: var(--surface);
  color: var(--navy);
}

.button-secondary:hover {
  border-color: var(--navy);
  color: var(--navy);
}

/* Homepage */
.home-hero {
  padding: 74px 0 30px;
}

.home-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: 34px;
  align-items: start;
}

.home-hero-copy {
  max-width: 44rem;
}

.home-hero h1 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(2.45rem, 5vw, 4.2rem);
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 1.02;
}

.home-intro {
  max-width: 43rem;
  margin: 20px 0 0;
  color: var(--text-muted);
  font-size: 1.12rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 26px;
}

.featured-card,
.topic-section-card,
.article-cta-box,
.publication-note-box,
.related-card {
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

.featured-card {
  padding: 28px;
  border-radius: var(--radius-lg);
  background: linear-gradient(160deg, #ffffff 0%, var(--surface-tint) 100%);
  box-shadow: var(--shadow-md);
}

.featured-card h2 {
  margin: 8px 0 0;
  color: var(--navy);
  font-size: clamp(1.4rem, 2vw, 1.95rem);
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.featured-card h2 a,
.post-card-title a,
.topic-section-card h2 a,
.related-card h3 a {
  color: var(--navy);
}

.featured-card h2 a:hover,
.post-card-title a:hover,
.topic-section-card h2 a:hover,
.related-card h3 a:hover {
  color: var(--blue-hover);
}

.featured-description,
.post-card-description,
.topic-section-card p,
.article-dek,
.article-cta-box p,
.publication-note-box p,
.related-card p {
  color: var(--text-muted);
}

.featured-description {
  margin: 14px 0 0;
}

.featured-image,
.post-card-image {
  display: block;
  overflow: hidden;
  margin-bottom: 18px;
  border-radius: var(--radius-md);
}

.featured-image img,
.post-card-image img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

.topic-strip {
  padding: 8px 0 18px;
}

.topic-strip-inner,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.topic-chip,
.tag {
  display: inline-flex;
  align-items: center;
  padding: 7px 11px;
  border-radius: 999px;
  background: var(--blue-soft);
  color: var(--blue-hover);
  font-size: 0.78rem;
  font-weight: 800;
  line-height: 1;
  text-decoration: none !important;
}

.topic-chip:hover,
.tag:hover {
  background: #d9eff9;
  color: var(--navy);
}

.tag-row-compact {
  margin: 0 0 12px;
}

.post-feed {
  padding: 10px 0 84px;
}

.post-card {
  padding: 30px 0;
  border-bottom: 1px solid var(--border);
}

.post-card:first-child {
  border-top: 1px solid var(--border);
}

.post-meta {
  margin: 0 0 10px;
  color: var(--text-soft);
  font-size: 0.86rem;
  font-weight: 600;
}

.post-card-title {
  margin: 0;
  color: var(--navy);
  font-size: clamp(1.4rem, 2.1vw, 2rem);
  letter-spacing: -0.035em;
  line-height: 1.18;
}

.post-card-description {
  max-width: 44rem;
  margin: 12px 0 0;
}

.post-card-link {
  margin: 14px 0 0;
}

.post-card-link a {
  color: var(--blue-hover);
  font-weight: 800;
}

.topic-sections {
  padding: 0 0 84px;
}

.topic-sections-grid,
.related-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.topic-section-card {
  padding: 24px;
  border-radius: var(--radius-lg);
}

.topic-section-card h2 {
  margin: 0 0 10px;
  color: var(--navy);
  font-size: 1.25rem;
  letter-spacing: -0.025em;
  line-height: 1.2;
}

.topic-section-card p {
  margin: 0;
}

/* Categories */
.category-page {
  padding: 56px 0 12px;
}

.category-block + .category-block {
  margin-top: 56px;
}

.category-block-header {
  margin-bottom: 18px;
}

.category-block-header h2 {
  margin: 0 0 6px;
  color: var(--navy);
  font-size: 1.65rem;
  letter-spacing: -0.035em;
  line-height: 1.16;
}

/* Article pages */
.article-wrap {
  padding: 54px 0 84px;
}

.article-header {
  margin-bottom: 34px;
  padding: 14px 0 30px;
  border-bottom: 1px solid var(--border);
}

.article-header h1 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(2.15rem, 4.2vw, 3.65rem);
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 1.05;
}

.article-tags {
  margin-bottom: 16px;
}

.article-dek {
  max-width: 43rem;
  margin: 18px 0 0;
  font-size: 1.12rem;
}

.article-featured-image {
  margin: 0 0 36px;
}

.article-featured-image img {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.article-body {
  color: var(--text);
  font-size: 1.03rem;
}

.article-body > *:first-child {
  margin-top: 0;
}

.article-body h2 {
  margin: 50px 0 16px;
  color: var(--navy);
  font-size: 1.8rem;
  letter-spacing: -0.035em;
  line-height: 1.16;
  scroll-margin-top: 100px;
}

.article-body h3 {
  margin: 34px 0 12px;
  color: var(--navy);
  font-size: 1.28rem;
  letter-spacing: -0.02em;
  line-height: 1.24;
  scroll-margin-top: 100px;
}

.article-body p,
.article-body ul,
.article-body ol,
.article-body blockquote {
  margin: 18px 0;
}

.article-body ul,
.article-body ol {
  padding-left: 1.35em;
}

.article-body li + li {
  margin-top: 10px;
}

.article-body strong {
  color: var(--navy);
}

.article-body blockquote {
  margin-left: 0;
  padding: 18px 20px;
  border-left: 4px solid var(--blue);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  background: var(--blue-soft);
  color: var(--navy);
}

.article-body hr {
  margin: 42px 0;
  border: 0;
  border-top: 1px solid var(--border);
}

.article-body img {
  margin: 28px 0 10px;
  box-shadow: var(--shadow-md);
}

.article-body em {
  color: var(--text-muted);
}

.article-body code {
  padding: 0.14em 0.35em;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface-soft);
  color: var(--navy);
  font-size: 0.9em;
}

.article-body pre {
  overflow-x: auto;
  padding: 18px;
  border-radius: var(--radius-md);
  background: var(--navy-deep);
  color: #f3f6fa;
  font-size: 0.92rem;
  line-height: 1.6;
}

.article-body pre code {
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
}

.article-body table {
  display: block;
  width: 100%;
  overflow-x: auto;
  margin: 24px 0;
  border-collapse: collapse;
  font-size: 0.94rem;
  -webkit-overflow-scrolling: touch;
}

.article-body th,
.article-body td {
  min-width: 140px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  text-align: left;
  vertical-align: top;
}

.article-body th {
  background: var(--surface-soft);
  color: var(--navy);
  font-weight: 800;
}

.article-body a {
  text-decoration: underline;
  text-decoration-color: rgba(32, 152, 205, 0.45);
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.article-body a:hover {
  text-decoration-color: var(--blue-hover);
  text-decoration-thickness: 2px;
}

.article-cta,
.publication-note,
.related-posts {
  margin-top: 56px;
}

.article-cta-box,
.publication-note-box {
  padding: 28px;
  border-radius: var(--radius-lg);
}

.article-cta-box h2,
.related-posts h2 {
  margin: 0 0 12px;
  color: var(--navy);
  font-size: 1.55rem;
  letter-spacing: -0.035em;
  line-height: 1.15;
}

.article-cta-box p,
.publication-note-box p {
  margin: 0;
}

.related-grid {
  margin-top: 18px;
}

.related-card {
  padding: 20px;
  border-radius: var(--radius-md);
}

.related-card h3 {
  margin: 0 0 10px;
  color: var(--navy);
  font-size: 1.1rem;
  line-height: 1.25;
}

.related-card p {
  margin: 0;
  font-size: 0.94rem;
}

/* Error page */
.not-found {
  padding: 84px 0 96px;
}

.not-found h1 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.045em;
  line-height: 1.1;
}

.not-found-recent {
  margin-top: 56px;
}

.not-found-recent h2 {
  margin: 0 0 18px;
  color: var(--navy);
  font-size: 1.4rem;
  letter-spacing: -0.025em;
}

/* Global footer */
.site-footer {
  margin-top: auto;
  border-top: 1px solid var(--border);
  background: var(--navy-deep);
  color: rgba(255, 255, 255, 0.82);
}

.footer-shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 20px 36px;
  align-items: end;
  padding: 34px 0 30px;
}

.footer-identity {
  max-width: 36rem;
}

.footer-brand {
  margin: 0;
  color: #fff;
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.footer-positioning {
  margin: 7px 0 0;
  color: rgba(255, 255, 255, 0.68);
  font-size: 0.88rem;
  line-height: 1.55;
}

.footer-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px 18px;
}

.footer-nav a {
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.84rem;
  font-weight: 700;
}

.footer-nav a:hover {
  color: #fff;
}

.footer-legal {
  grid-column: 1 / -1;
  margin: 2px 0 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.78rem;
}

@media (max-width: 900px) {
  .home-hero-grid,
  .related-grid,
  .topic-sections-grid {
    grid-template-columns: 1fr;
  }

  .footer-shell {
    grid-template-columns: 1fr;
    align-items: start;
  }

  .footer-nav {
    justify-content: flex-start;
  }
}

@media (max-width: 760px) {
  body {
    font-size: 17px;
  }

  .site-shell {
    width: min(calc(100% - 32px), var(--max-shell));
  }

  .header-shell {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-height: auto;
    padding: 16px 0;
  }

  .site-nav {
    justify-content: flex-start;
    gap: 4px 16px;
  }

  .site-nav a {
    padding: 7px 0;
    font-size: 0.84rem;
  }

  .home-hero {
    padding: 46px 0 20px;
  }

  .home-hero h1 {
    font-size: clamp(2.25rem, 11vw, 3.15rem);
  }

  .featured-card,
  .topic-section-card,
  .article-cta-box,
  .publication-note-box,
  .related-card {
    padding: 22px;
  }

  .post-feed {
    padding-bottom: 58px;
  }

  .article-wrap {
    padding: 32px 0 60px;
  }

  .article-header {
    margin-bottom: 26px;
    padding-bottom: 24px;
  }

  .article-body h2 {
    margin-top: 38px;
    font-size: 1.52rem;
  }

  .article-body h3 {
    font-size: 1.15rem;
  }

  .footer-shell {
    padding: 30px 0 26px;
  }

  .footer-nav {
    gap: 9px 15px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
